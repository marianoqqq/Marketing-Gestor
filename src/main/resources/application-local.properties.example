# ==============================================================
# JWT Secret para entorno local
# ==============================================================
jwt.secret=

# ==============================================================
# Groq (Generación de texto de publicaciones)
# ==============================================================
spring.ai.openai.api-key=gsk_...
spring.ai.openai.chat.options.model=openai/gpt-oss-120b

# ==============================================================
# OpenAI (Generación de imágenes con GPT-Image-2.5 / DALL-E)
# ==============================================================
# openai.image.api-key=sk-...
# openai.image.model=gpt-image-2.5
# openai.image.base-url=https://api.openai.com/v1

# ==============================================================
# Base de Datos: Neon PostgreSQL
# ==============================================================
spring.datasource.url=jdbc:postgresql://ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
spring.datasource.username=neondb_owner
spring.datasource.password=
spring.datasource.driver-class-name=org.postgresql.Driver

# ==============================================================
# Cloudflare R2 (Almacenamiento de fotos en la nube - Opcional)
# ==============================================================
# cloudflare.r2.account-id=tu_account_id
# cloudflare.r2.bucket-name=inmo-marketing-fotos
# cloudflare.r2.endpoint=https://<account_id>.r2.cloudflarestorage.com
# cloudflare.r2.access-key=tu_access_key_id
# cloudflare.r2.secret-key=tu_secret_access_key
# cloudflare.r2.public-url=https://pub-xxxx.r2.dev

